#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

IDD_ASSISTANT DIALOGEX 0, 0, 440, 350
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "无限视距助手"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "无限视距助手", IDC_HEADING, 18, 14, 280, 22
    LTEXT "选择游戏目录，设置功能后写入，下次进入对局时加载。", -1, 18, 42, 404, 14
    GROUPBOX "游戏目录", -1, 16, 62, 408, 65
    EDITTEXT IDC_GAME_PATH, 26, 80, 388, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "选择目录…", IDC_BROWSE, 248, 102, 78, 17
    PUSHBUTTON "自动查找", IDC_DETECT, 334, 102, 78, 17
    GROUPBOX "插件配置", -1, 16, 136, 408, 67
    CONTROL "无限视距", IDC_VISION, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 152, 124, 14
    CONTROL "攻击范围", IDC_ATTACK_RANGE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 163, 152, 112, 14
    CONTROL "视距防回弹", IDC_ANTI_RECOIL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 296, 152, 116, 14
    CONTROL "防御塔范围", IDC_TOWER_RANGE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 178, 124, 14
    CONTROL "显示调试窗口", IDC_CONSOLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 163, 178, 124, 14
    DEFPUSHBUTTON "写入视距插件", IDC_INSTALL, 18, 214, 126, 24
    PUSHBUTTON "打开插件目录", IDC_OPEN_FOLDER, 156, 214, 112, 24
    GROUPBOX "清理", -1, 16, 248, 408, 54
    PUSHBUTTON "清理插件", IDC_CLEAN_PLUGIN, 28, 268, 126, 22
    PUSHBUTTON "清理插件和注入器", IDC_CLEAN_ALL, 166, 268, 158, 22
    LTEXT "请选择 Game 目录；游戏大厅点击写入或清理。", IDC_STATUS, 18, 314, 402, 28
END

IDR_PLUGIN RCDATA "@ASSISTANT_PLUGIN@"
IDR_LOADER RCDATA "@ASSISTANT_LOADER@"
IDR_CONFIG RCDATA "@ASSISTANT_CONFIG@"

1 RT_MANIFEST "@ASSISTANT_MANIFEST@"

1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "无限视距助手\0"
            VALUE "FileVersion", "1.1.0\0"
            VALUE "ProductName", "无限视距助手\0"
            VALUE "ProductVersion", "1.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
