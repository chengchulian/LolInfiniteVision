#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

IDD_ASSISTANT DIALOGEX 0, 0, 440, 454
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "无限视距助手"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "无限视距助手", IDC_HEADING, 18, 14, 280, 22
    LTEXT "选择游戏目录，设置功能后写入，下次进入对局时加载。", -1, 18, 42, 404, 14
    GROUPBOX "游戏目录", -1, 16, 62, 408, 65
    EDITTEXT IDC_GAME_PATH, 26, 80, 388, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "选择目录…", IDC_BROWSE, 248, 102, 78, 17
    PUSHBUTTON "自动查找", IDC_DETECT, 334, 102, 78, 17
    GROUPBOX "加载器", -1, 16, 136, 408, 89
    CONTROL "version.dll", IDC_LOADER_VERSION, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 28, 153, 96, 14
    CONTROL "dinput8.dll", IDC_LOADER_DINPUT8, "Button", BS_AUTORADIOBUTTON, 130, 153, 96, 14
    PUSHBUTTON "写入加载器", IDC_INSTALL_LOADER, 238, 150, 82, 20
    PUSHBUTTON "清理加载器", IDC_CLEAN_LOADER, 328, 150, 84, 20
    LTEXT "请选择游戏目录以检测当前加载器。", IDC_LOADER_STATUS, 28, 178, 384, 40
    GROUPBOX "功能开关与游戏内快捷键", -1, 16, 234, 408, 131, WS_GROUP
    LTEXT "初始开关", -1, 28, 248, 120, 12
    LTEXT "快捷键（点击输入，可组合 Ctrl / Alt / Shift）", -1, 166, 248, 246, 12
    CONTROL "无限视距", IDC_VISION, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 266, 124, 14
    CONTROL "", IDC_HOTKEY_VISION, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 166, 264, 246, 17
    CONTROL "攻击范围", IDC_ATTACK_RANGE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 289, 124, 14
    CONTROL "", IDC_HOTKEY_ATTACK_RANGE, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 166, 287, 246, 17
    CONTROL "视距防回弹", IDC_ANTI_RECOIL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 312, 124, 14
    CONTROL "", IDC_HOTKEY_ANTI_RECOIL, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 166, 310, 246, 17
    CONTROL "防御塔范围", IDC_TOWER_RANGE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 335, 124, 14
    CONTROL "", IDC_HOTKEY_TOWER_RANGE, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 166, 333, 246, 17
    LTEXT "对局中按快捷键切换；按退格键清空绑定。初始开关在下次进入游戏时生效。", -1, 18, 371, 404, 24
    DEFPUSHBUTTON "写入视距插件", IDC_INSTALL, 18, 400, 126, 24
    PUSHBUTTON "打开插件目录", IDC_OPEN_FOLDER, 156, 400, 126, 24
    PUSHBUTTON "清理插件", IDC_CLEAN_PLUGIN, 294, 400, 126, 24
    LTEXT "请选择 Game 目录；游戏大厅点击写入或清理。", IDC_STATUS, 18, 430, 402, 22
END

IDR_PLUGIN RCDATA "@ASSISTANT_PLUGIN@"
IDR_LOADER RCDATA "@ASSISTANT_LOADER@"
IDR_DINPUT8_LOADER RCDATA "@ASSISTANT_DINPUT8_LOADER@"
IDR_CONFIG RCDATA "@ASSISTANT_CONFIG@"

1 RT_MANIFEST "@ASSISTANT_MANIFEST@"

1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "无限视距助手\0"
            VALUE "FileVersion", "1.1.0\0"
            VALUE "ProductName", "无限视距助手\0"
            VALUE "ProductVersion", "1.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
