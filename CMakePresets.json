{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ninja-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "ninja-debug",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-release",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "vs2026-x64-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "Visual Studio"
        }
      }
    },
    {
      "name": "vs2026-x64-debug",
      "inherits": "vs2026-x64-base"
    },
    {
      "name": "vs2026-x64-release",
      "inherits": "vs2026-x64-base"
    }
  ],
  "buildPresets": [
    {
      "name": "build-x64-debug",
      "configurePreset": "vs2026-x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "build-x64-release",
      "configurePreset": "vs2026-x64-release",
      "configuration": "Release"
    }
  ]
}
